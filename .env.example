# Copia este archivo como .env (cp .env.example .env) y ajusta si lo necesitas.

# --- Base de datos en Docker (docker-compose.yml) ---
POSTGRES_USER=kronopet
POSTGRES_PASSWORD=kronopet
POSTGRES_DB=kronopet_db
# Puerto del host donde se expone Postgres. 5433 para no chocar con un Postgres local en 5432.
DB_PORT=5433

# --- Backend ---
# Debe coincidir con los valores de arriba.
DATABASE_URL="postgresql://kronopet:kronopet@localhost:5433/kronopet_db?schema=public"
PORT=3001
JWT_SECRET=cambia-este-secreto
